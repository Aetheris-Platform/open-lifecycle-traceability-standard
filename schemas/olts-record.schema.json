{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:olts:schema:v1:record",
  "$comment": "Candidate stable OLTS v1 schema identifier. Publication remains gated by the OLTS v1.0.0 release process.",
  "title": "OLTS Lifecycle Record",
  "description": "Candidate v1 schema for one OLTS lifecycle record. Local extensions may add fields, but core fields remain reviewable and explicit. Validators MUST also check that the type field matches the type segment in id.",
  "type": "object",
  "required": ["id", "type", "title"],
  "properties": {
    "id": {
      "$ref": "#/$defs/oltsIdentifier"
    },
    "type": {
      "$ref": "#/$defs/entityType",
      "description": "Entity type code. Validators MUST check that this value matches the type segment in id, such as SR in APP-SR-00014."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Repository-defined lifecycle status. Status is not part of the stable identifier."
    },
    "source": {
      "$ref": "#/$defs/provenance"
    },
    "implements": {
      "$ref": "#/$defs/referenceList"
    },
    "realizes": {
      "$ref": "#/$defs/referenceList"
    },
    "requires": {
      "$ref": "#/$defs/referenceList"
    },
    "specified_by": {
      "$ref": "#/$defs/referenceList"
    },
    "verified_by": {
      "$ref": "#/$defs/referenceList"
    },
    "validated_by": {
      "$ref": "#/$defs/referenceList"
    },
    "evidenced_by": {
      "$ref": "#/$defs/referenceList"
    },
    "documents": {
      "$ref": "#/$defs/referenceList"
    },
    "explained_by": {
      "$ref": "#/$defs/referenceList"
    },
    "supersedes": {
      "$ref": "#/$defs/referenceList"
    },
    "extensions": {
      "type": "object",
      "description": "Optional repository-defined extension fields."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "oltsIdentifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[A-Z][A-Z0-9]{1,9}-[0-9]{5}$",
      "examples": ["APP-SR-00014"]
    },
    "entityType": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,9}$",
      "description": "Core draft types are CAP, TRK, UC, SR, VT, VAL, EVD, ART, and ADR. Other values are local extensions and should be documented."
    },
    "externalReference": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*:.+",
      "examples": ["jira:PROJ-123", "openspec:change-id", "NIST-SP-800-53:AU-2"]
    },
    "idOrExternalReference": {
      "anyOf": [
        { "$ref": "#/$defs/oltsIdentifier" },
        { "$ref": "#/$defs/externalReference" }
      ]
    },
    "referenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/idOrExternalReference"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "file": { "type": "string" },
        "row": { "type": "integer", "minimum": 1 },
        "section": { "type": "string" },
        "external_system": { "type": "string" },
        "external_key": { "type": "string" },
        "commit": { "type": "string" },
        "source_hash": { "type": "string" },
        "inspected_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  }
}
